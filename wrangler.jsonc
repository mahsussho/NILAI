{
  // Satu Worker: file frontend/ dilayani sebagai aset statis, /api/* ditangani backend/src/index.js
  "name": "nilai",
  "main": "backend/src/index.js",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./frontend",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "arsip_digital", "database_id": "2e0c087b-b499-4260-a976-a7723ee7d27e" }
  ]
}
