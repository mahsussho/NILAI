{
  // Satu Worker: file frontend/ dilayani sebagai aset statis, /api/* ditangani backend/src/index.js
  "name": "nilai",
  "main": "backend/src/index.js",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./frontend",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "nilai-siswa", "database_id": "ISI_DATABASE_ID_DARI_wrangler_d1_create" }
  ]
}
